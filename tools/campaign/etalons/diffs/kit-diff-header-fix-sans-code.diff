+import contextlib
+import io
+import json
+import os
+from pathlib import Path
+import shutil
+import stat
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / 'template/scripts/lib'))
+sys.path.insert(0, str(ROOT / 'tools/campaign'))
+import delegate_run
+import etalons_harvest
+from scope import fingerprint
+
+IDENTITY = dict(GIT_AUTHOR_NAME='Test', GIT_AUTHOR_EMAIL='test@example.org',
+                GIT_COMMITTER_NAME='Test', GIT_COMMITTER_EMAIL='test@example.org')
+OLD_DIFF = (b'diff --git/notes.txt b/notes.txt\nnew file mode 100600\n--- /dev/null\n+++ b/notes.txt\n'
+            b'@@ -0,0 +1 @@\n+hello\n')
+
+
+def write(root, name, text, mode):
+    path = root / name
+    path.write_text(text)
+    os.chmod(str(path), mode)
+
+
+class GitModeTests(unittest.TestCase):
+    def test_regular_file_without_execute_bit(self):
+        self.assertEqual(delegate_run.git_mode(0o100600), '100644')
+        self.assertEqual(delegate_run.git_mode(0o100644), '100644')
+
+    def test_executable_file(self):
+        self.assertEqual(delegate_run.git_mode(0o100755), '100755')
+        self.assertEqual(delegate_run.git_mode(0o100711), '100755')
+
+    def test_symbolic_link(self):
+        self.assertEqual(delegate_run.git_mode(0o120777), '120000')
+
