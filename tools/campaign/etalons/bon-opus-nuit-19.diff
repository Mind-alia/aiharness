+++ b/apps/service/src/domain/usage/quota-projection.test.ts
@@ -0,0 +1,202 @@
+import { describe, expect, it } from 'vitest';
+import { QuotaProjectionSchema, type QuotaProjection } from '@wsc/contracts';
+import {
+  QUOTA_PROJECTION_DROP_TOLERANCE_PERCENT,
+  QUOTA_PROJECTION_MAX_AGE_MS,
+  QUOTA_PROJECTION_MAX_DATE_MS,
+  QUOTA_PROJECTION_MIN_DATE_MS,
+  QUOTA_PROJECTION_MIN_INCREASE_PERCENT,
+  QUOTA_PROJECTION_MIN_SPAN_MS,
+  QUOTA_PROJECTION_RESET_TOLERANCE_MS,
+  projectQuota,
+  type QuotaObservation,
+} from './quota-projection.js';
+
+const NOW = new Date('2026-10-18T12:00:00.000Z');
+const RESET = '2026-10-18T15:00:00.000Z';
+
+function obs(time: string, percent: number, resetsAt = RESET): QuotaObservation {
+  return { at: `2026-10-18T${time}Z`, percent, resetsAt };
+}
+
+function project(observations: readonly QuotaObservation[], now = NOW): QuotaProjection {
+  const result = projectQuota(observations, now);
+  expect(QuotaProjectionSchema.parse(result)).toEqual(result);
+  return result;
+}
+
+function unknown(reason: string): QuotaProjection {
+  return { status: 'unknown', reason, fiabilite: 'inconnu' } as QuotaProjection;
+}
+
+function available(observedFrom: string, observedTo: string, exhaustedAt: string, resetsBeforeExhaustion: boolean): QuotaProjection {
+  return {
+    status: 'available',
+    exhaustedAt: `2026-10-18T${exhaustedAt}.000Z`,
+    observedFrom: `2026-10-18T${observedFrom}.000Z`,
+    observedTo: `2026-10-18T${observedTo}.000Z`,
+    fiabilite: 'estime',
+    resetsBeforeExhaustion,
+  };
+}
+
+describe('projectQuota', () => {
+  it('exposes the imposed thresholds', () => {
+    expect(QUOTA_PROJECTION_MAX_AGE_MS).toBe(30 * 60_000);
+    expect(QUOTA_PROJECTION_MIN_SPAN_MS).toBe(10 * 60_000);
+    expect(QUOTA_PROJECTION_RESET_TOLERANCE_MS).toBe(5 * 60_000);
+    expect(QUOTA_PROJECTION_MIN_INCREASE_PERCENT).toBe(1);
+    expect(QUOTA_PROJECTION_DROP_TOLERANCE_PERCENT).toBe(1);
+    expect(QUOTA_PROJECTION_MIN_DATE_MS).toBe(Date.parse('2000-01-01T00:00:00.000Z'));
+    expect(QUOTA_PROJECTION_MAX_DATE_MS).toBe(Date.parse('2100-01-01T00:00:00.000Z'));
+  });
+
+  it('projects exhaustion from the cycle ends (example 1)', () => {
+    expect(project([obs('11:00:00', 20), obs('11:30:00', 35), obs('12:00:00', 50)]))
+      .toEqual(available('11:00:00', '12:00:00', '13:40:00', false));
+  });
+
+  it('says the reset comes first when it does (example 2)', () => {
+    expect(project([obs('11:00:00', 20), obs('12:00:00', 30)]))
+      .toEqual(available('11:00:00', '12:00:00', '19:00:00', true));
+  });
+
+  it('counts a reset exactly at exhaustion as coming first', () => {
+    const reset = '2026-10-18T13:40:00Z';
+    expect(project([obs('11:00:00', 20, reset), obs('12:00:00', 50, reset)]))
+      .toEqual(available('11:00:00', '12:00:00', '13:40:00', true));
+  });
+
+  it('rounds the projected instant to the nearest millisecond', () => {
+    const result = project([obs('11:00:00', 0), obs('12:00:00', 3)]);
+    expect(result).toMatchObject({ status: 'available', exhaustedAt: '2026-10-19T20:20:00.000Z' });
+    const odd = project([obs('11:00:00', 0), obs('11:10:00.001', 7)], new Date('2026-10-18T11:10:00.001Z'));
+    expect(odd).toMatchObject({ status: 'available', exhaustedAt: new Date(Math.round(Date.parse('2026-10-18T11:10:00.001Z') + 93 / (7 / 600_001))).toISOString() });
+  });
+
+  it('handles empty input and an invalid now', () => {
+    expect(project([])).toEqual(unknown('insufficient_data'));
+    expect(project([], new Date(Number.NaN))).toEqual(unknown('invalid'));
+    expect(project([obs('11:00:00', 20), obs('12:00:00', 30)], new Date('nope'))).toEqual(unknown('invalid'));
+  });
+
+  it('needs two observations unless the window is already full', () => {
+    expect(project([obs('12:00:00', 40)])).toEqual(unknown('insufficient_data'));
+    expect(project([obs('12:00:00', 100)])).toEqual(available('12:00:00', '12:00:00', '12:00:00', false));
+  });
+
+  it('dates exhaustion at the first observation at 100 in the cycle', () => {
+    expect(project([obs('11:00:00', 20), obs('11:30:00', 100), obs('12:00:00', 100)]))
+      .toEqual(available('11:00:00', '11:30:00', '11:30:00', false));
+  });
+
+  it('needs at least ten minutes between the cycle ends', () => {
+    expect(project([obs('11:51:00', 20), obs('12:00:00', 30)])).toEqual(unknown('insufficient_data'));
+    expect(project([obs('11:50:00', 20), obs('12:00:00', 30)])).toMatchObject({ status: 'available' });
+  });
+
+  it('accepts a last observation exactly thirty minutes old and rejects an older one', () => {
+    expect(project([obs('11:00:00', 20), obs('11:30:00', 30)])).toMatchObject({ status: 'available', observedTo: '2026-10-18T11:30:00.000Z' });
+    expect(project([obs('10:30:00', 20), obs('11:00:00', 30)])).toEqual(unknown('stale'));
+  });
+
+  it('is stale when the announced reset is now or past', () => {
+    expect(project([obs('14:40:00', 20), obs('14:50:00', 30)], new Date(RESET)))
+      .toEqual(unknown('stale'));
+    expect(project([obs('11:40:00', 20, '2026-10-18T11:55:00Z'), obs('11:50:00', 30, '2026-10-18T11:55:00Z')]))
+      .toEqual(unknown('stale'));
+    expect(project([obs('11:40:00', 20, '2026-10-18T12:00:00Z'), obs('11:50:00', 30, '2026-10-18T12:00:00Z')]))
+      .toEqual(unknown('stale'));
+  });
+
+  it('reports flat consumption as not increasing', () => {
+    expect(project([obs('11:00:00', 40), obs('12:00:00', 40.5)])).toEqual(unknown('not_increasing'));
+    expect(project([obs('11:00:00', 0), obs('12:00:00', 0)])).toEqual(unknown('not_increasing'));
+    expect(project([obs('11:00:00', 40), obs('12:00:00', 41)])).toMatchObject({ status: 'available' });
+  });
+
+  it('reports a rate too slow to land before 2100 as not increasing', () => {
+    const slow = [{ at: '2000-01-01T00:00:00Z', percent: 0, resetsAt: RESET }, obs('12:00:00', 1)];
+    expect(project(slow)).toEqual(unknown('not_increasing'));
+  });
+
+  it('tolerates a one point drop and rejects a larger one', () => {
+    expect(project([obs('11:00:00', 20), obs('11:30:00', 36), obs('12:00:00', 35)])).toMatchObject({ status: 'available' });
+    expect(project([obs('11:00:00', 20), obs('11:30:00', 36), obs('12:00:00', 34.9)])).toEqual(unknown('invalid'));
+    expect(project([obs('11:00:00', 20), obs('11:30:00', 40), obs('12:00:00', 30)])).toEqual(unknown('invalid'));
+  });
+
+  it('tolerates a few seconds of jitter on the announced reset', () => {
+    expect(project([obs('11:00:00', 20, '2026-10-18T15:00:30Z'), obs('12:00:00', 50)]))
+      .toEqual(available('11:00:00', '12:00:00', '13:40:00', false));
+  });
+
+  it('rejects an older observation announcing a later reset', () => {
+    expect(project([obs('11:00:00', 20, '2026-10-18T16:00:00Z'), obs('12:00:00', 50)])).toEqual(unknown('reset_mismatch'));
+  });
+
+  it('rejects an observation of another cycle inside the current one', () => {
+    expect(project([obs('11:00:00', 20), obs('11:30:00', 90, '2026-10-18T11:45:00Z'), obs('12:00:00', 50)]))
+      .toEqual(unknown('reset_mismatch'));
+  });
+
+  it('ignores the observations of a previous cycle', () => {
+    const previous = [obs('09:00:00', 70, '2026-10-18T10:00:00Z'), obs('09:50:00', 90, '2026-10-18T10:00:00Z')];
+    expect(project([...previous, obs('11:00:00', 20), obs('12:00:00', 50)]))
+      .toEqual(available('11:00:00', '12:00:00', '13:40:00', false));
+    expect(project([...previous, obs('12:00:00', 40)])).toEqual(unknown('insufficient_data'));
+  });
+
+  it.each([-1, 100.5, Number.NaN, Number.POSITIVE_INFINITY])('rejects percent %s', percent => {
+    expect(project([obs('11:00:00', 20), obs('12:00:00', percent)])).toEqual(unknown('invalid'));
+  });
+
+  it.each([
+    'pas une date',
+    '2026-10-18',
+    '2026-10-18T15:00:00',
+    '',
+    '1999-12-31T23:59:59Z',
+    '2100-01-01T00:00:00Z',
+    '2026-02-30T15:00:00Z',
+    '2026-10-18T15:00Z',
+  ])('rejects the date %j as at or resetsAt', value => {
+    expect(project([obs('11:00:00', 20), { at: value, percent: 30, resetsAt: RESET }])).toEqual(unknown('invalid'));
+    expect(project([obs('11:00:00', 20), { ...obs('12:00:00', 30), resetsAt: value }])).toEqual(unknown('invalid'));
+  });
+
+  it('rejects an observation after now or a reset not after its observation', () => {
+    expect(project([obs('11:00:00', 20), obs('12:00:01', 30)])).toEqual(unknown('invalid'));
+    expect(project([obs('11:00:00', 20), obs('12:00:00', 30, '2026-10-18T12:00:00Z')])).toEqual(unknown('invalid'));
+    expect(project([obs('11:00:00', 20), obs('12:00:00', 30, '2026-10-18T11:59:00Z')])).toEqual(unknown('invalid'));
+  });
+
+  it('keeps one of identical duplicates and rejects conflicting ones', () => {
+    const duplicate = { at: '2026-10-18T14:00:00+02:00', percent: 50, resetsAt: '2026-10-18T17:00:00+02:00' };
+    expect(project([obs('11:00:00', 20), obs('12:00:00', 50), duplicate]))
+      .toEqual(available('11:00:00', '12:00:00', '13:40:00', false));
+    expect(project([obs('11:00:00', 20), obs('12:00:00', 50), obs('12:00:00', 51)])).toEqual(unknown('invalid'));
+    expect(project([obs('11:00:00', 20), obs('12:00:00', 50), obs('12:00:00', 50, '2026-10-18T15:00:30Z')])).toEqual(unknown('invalid'));
+  });
+
+  it('lets an invalid observation win over stale and insufficient data, and stale win over reset mismatch', () => {
+    expect(project([obs('10:00:00', 20), obs('10:30:00', -1)])).toEqual(unknown('invalid'));
+    expect(project([obs('12:00:00', 120)])).toEqual(unknown('invalid'));
+    expect(project([obs('10:00:00', 20, '2026-10-18T16:00:00Z'), obs('11:00:00', 50)])).toEqual(unknown('stale'));
+  });
+
+  it('normalises offset dates to UTC', () => {
+    const shifted = [
+      { at: '2026-10-18T13:00:00+02:00', percent: 20, resetsAt: '2026-10-18T17:00:00+02:00' },
+      { at: '2026-10-18T14:00:00+02:00', percent: 50, resetsAt: '2026-10-18T17:00:00+02:00' },
+    ];
+    expect(project(shifted)).toEqual(available('11:00:00', '12:00:00', '13:40:00', false));
+  });
+
+  it('does not depend on input order and leaves frozen input untouched', () => {
+    const ordered = [obs('11:00:00', 20), obs('11:30:00', 35), obs('12:00:00', 50)];
+    const frozen = Object.freeze([ordered[2], ordered[0], ordered[1]].map(item => Object.freeze({ ...item })));
+    expect(project(frozen)).toEqual(project(ordered));
+    expect(frozen.map(item => item.at)).toEqual(['2026-10-18T12:00:00Z', '2026-10-18T11:00:00Z', '2026-10-18T11:30:00Z']);
+  });
+});
