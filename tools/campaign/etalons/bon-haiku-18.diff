@@ -0,0 +1,282 @@
+import { QuotaProjectionSchema, type QuotaProjection, type QuotaProjectionUnknownReason } from '@wsc/contracts';
+import { describe, expect, it } from 'vitest';
+import {
+  QUOTA_PROJECTION_HORIZON_MS, QUOTA_PROJECTION_MIN_SPAN_MS, QUOTA_PROJECTION_STALE_AFTER_MS,
+  QUOTA_RESET_TOLERANCE_MS, projectQuota,
+} from './quota-projection.js';
+
+const MINUTE_MS = 60_000;
+const HOUR_MS = 60 * MINUTE_MS;
+const T0 = Date.parse('2026-10-18T10:00:00.000Z');
+const iso = (ms: number) => new Date(ms).toISOString();
+const NOW = new Date(T0 + 21 * MINUTE_MS);
+const RESET = T0 + 5 * HOUR_MS;
+
+const obs = (minutes: number, percent: number, resetsAt = RESET) => ({
+  at: iso(T0 + minutes * MINUTE_MS), percent, resetsAt: iso(resetsAt),
+});
+
+/** A result whose `reason` can be read without narrowing on `status`. */
+type ProjectionResult = QuotaProjection & { reason?: QuotaProjectionUnknownReason };
+
+/** Every result must also be accepted by the public contract. */
+const checked = (result: ProjectionResult): ProjectionResult => {
+  expect(QuotaProjectionSchema.parse(result)).toEqual(result);
+  return result;
+};
+
+describe('projectQuota input and constants', () => {
+  it('exposes the thresholds fixed by the brief', () => {
+    expect(QUOTA_PROJECTION_MIN_SPAN_MS).toBe(600_000);
+    expect(QUOTA_PROJECTION_STALE_AFTER_MS).toBe(1_800_000);
+    expect(QUOTA_RESET_TOLERANCE_MS).toBe(60_000);
+    expect(QUOTA_PROJECTION_HORIZON_MS).toBe(Date.UTC(2100, 0, 1));
+  });
+
+  it('returns invalid when now is not a finite Date', () => {
+    expect(checked(projectQuota([obs(0, 10)], new Date(Number.NaN)))).toEqual({ status: 'unknown', reason: 'invalid', fiabilite: 'inconnu' });
+    expect(checked(projectQuota([obs(0, 10)], '2026-10-18' as unknown as Date)).reason).toBe('invalid');
+  });
+
+  it('returns invalid when observations is not an array', () => {
+    expect(checked(projectQuota(null as unknown as never[], NOW)).reason).toBe('invalid');
+    expect(checked(projectQuota({} as unknown as never[], NOW)).reason).toBe('invalid');
+  });
+
+  it('does not mutate the input array nor its elements', () => {
+    const observations = [obs(20, 30), obs(0, 10)];
+    const snapshot = structuredClone(observations);
+    projectQuota(observations, NOW);
+    expect(observations).toEqual(snapshot);
+  });
+
+  it('accepts frozen arrays and objects and leaves them unchanged', () => {
+    const observations = Object.freeze([Object.freeze(obs(0, 10)), Object.freeze(obs(20, 30))]);
+    expect(checked(projectQuota(observations, NOW)).status).toBe('available');
+    expect(observations).toHaveLength(2);
+  });
+});
+
+describe('projectQuota validity of each observation', () => {
+  const valid = (overrides: Record<string, unknown>) => ({ ...obs(0, 10), ...overrides });
+  const defects: [string, unknown][] = [
+    ['percent above 100', valid({ percent: 101 })],
+    ['percent below 0', valid({ percent: -1 })],
+    ['percent NaN', valid({ percent: Number.NaN })],
+    ['percent Infinity', valid({ percent: Number.POSITIVE_INFINITY })],
+    ['percent as a string', valid({ percent: '10' })],
+    ['at not a date', valid({ at: 'pas une date' })],
+    ['at date only', valid({ at: '2026-10-18' })],
+    ['at without offset', valid({ at: '2026-10-18T10:00:00' })],
+    ['resetsAt unreadable', valid({ resetsAt: 'demain' })],
+    ['at after now', valid({ at: iso(NOW.getTime() + 1) })],
+    ['resetsAt not after at', valid({ resetsAt: obs(0, 10).at })],
+    ['extra key', valid({ extra: true })],
+    ['missing key', { at: obs(0, 10).at, percent: 10 }],
+    ['null element', null],
+    ['array element', [1, 2, 3]],
+  ];
+
+  it.each(defects)('returns invalid for %s', (_label, defect) => {
+    const observations = [obs(20, 30), defect] as unknown as never[];
+    expect(checked(projectQuota(observations, NOW))).toEqual({ status: 'unknown', reason: 'invalid', fiabilite: 'inconnu' });
+  });
+
+  it('lets an invalid observation outside the current window make the whole input invalid', () => {
+    const old = { at: 'pas une date', percent: 5, resetsAt: obs(0, 5).resetsAt };
+    const observations = [old, obs(0, 10), obs(20, 30)];
+    expect(checked(projectQuota(observations, NOW)).reason).toBe('invalid');
+  });
+
+  it('gives invalid precedence over stale', () => {
+    const observations = [obs(0, 10), { ...obs(1, 20), percent: 500 }];
+    expect(checked(projectQuota(observations, new Date(T0 + 5 * HOUR_MS))).reason).toBe('invalid');
+  });
+
+  it('accepts ISO dates with offsets and normalizes them to UTC with milliseconds', () => {
+    const observations = [
+      { at: '2026-10-18T12:00:00+02:00', percent: 10, resetsAt: '2026-10-18T15:00:00.000Z' },
+      { at: '2026-10-18T12:20:00.5+02:00', percent: 30, resetsAt: '2026-10-18T15:00:00.000Z' },
+    ];
+    expect(checked(projectQuota(observations, NOW))).toEqual({
+      status: 'available',
+      exhaustedAt: '2026-10-18T11:30:02.000Z',
+      observedFrom: '2026-10-18T10:00:00.000Z',
+      observedTo: '2026-10-18T10:20:00.500Z',
+      fiabilite: 'estime',
+      resetsBeforeExhaustion: false,
+    });
+  });
+});
+
+describe('projectQuota duplicates and emptiness', () => {
+  it('returns insufficient_data for an empty array', () => {
+    expect(checked(projectQuota([], NOW))).toEqual({ status: 'unknown', reason: 'insufficient_data', fiabilite: 'inconnu' });
+  });
+
+  it('merges identical observations at the same instant', () => {
+    const observations = [obs(0, 10), obs(0, 10), obs(20, 30)];
+    expect(checked(projectQuota(observations, NOW)).status).toBe('available');
+  });
+
+  it('returns invalid for two observations at the same instant that differ', () => {
+    expect(checked(projectQuota([obs(0, 10), obs(0, 11), obs(20, 30)], NOW)).reason).toBe('invalid');
+    expect(checked(projectQuota([obs(0, 10), obs(0, 10, RESET + 1000), obs(20, 30)], NOW)).reason).toBe('invalid');
+  });
+});
+
+describe('projectQuota freshness', () => {
+  it('keeps an observation exactly 30 minutes old fresh', () => {
+    const now = new Date(T0 + 20 * MINUTE_MS + QUOTA_PROJECTION_STALE_AFTER_MS);
+    expect(checked(projectQuota([obs(0, 10), obs(20, 30)], now)).status).toBe('available');
+  });
+
+  it('returns stale for an observation 31 minutes old', () => {
+    const now = new Date(T0 + 20 * MINUTE_MS + QUOTA_PROJECTION_STALE_AFTER_MS + 1);
+    expect(checked(projectQuota([obs(0, 10), obs(20, 30)], now)).reason).toBe('stale');
+  });
+
+  it('returns stale when the observed window has already reset', () => {
+    expect(checked(projectQuota([obs(0, 10), obs(20, 30, T0 + 21 * MINUTE_MS)], NOW)).reason).toBe('stale');
+  });
+
+  it('returns stale when resetsAt equals now', () => {
+    const now = new Date(RESET);
+    expect(checked(projectQuota([obs(0, 10), obs(299, 30)], now)).reason).toBe('stale');
+  });
+});
+
+describe('projectQuota window selection', () => {
+  it('uses only the newest window when an earlier window was followed by a reset', () => {
+    const previousReset = T0 + 20 * MINUTE_MS;
+    const newReset = T0 + 6 * HOUR_MS;
+    const observations = [obs(0, 80, previousReset), obs(30, 2, newReset), obs(40, 4, newReset), obs(60, 8, newReset)];
+    const now = new Date(T0 + 61 * MINUTE_MS);
+    const result = checked(projectQuota(observations, now));
+    expect(result).toMatchObject({ status: 'available', observedFrom: iso(T0 + 30 * MINUTE_MS) });
+  });
+
+  it('returns insufficient_data when the newest window holds a single observation', () => {
+    const previousReset = T0 + 20 * MINUTE_MS;
+    const newReset = T0 + 6 * HOUR_MS;
+    const observations = [obs(0, 80, previousReset), obs(30, 2, newReset)];
+    expect(checked(projectQuota(observations, new Date(T0 + 31 * MINUTE_MS))).reason).toBe('insufficient_data');
+  });
+
+  it('keeps observations whose resetsAt varies by 30 seconds in the same window', () => {
+    const observations = [obs(0, 10, RESET), obs(20, 30, RESET + 30_000)];
+    expect(checked(projectQuota(observations, NOW)).status).toBe('available');
+  });
+
+  it('starts a new window when resetsAt varies by 61 seconds, and reports reset_mismatch if the old one had not ended', () => {
+    const observations = [obs(0, 10, RESET), obs(20, 30, RESET + 61_000)];
+    expect(checked(projectQuota(observations, NOW)).reason).toBe('reset_mismatch');
+  });
+
+  it('starts a new window once the previous reset has passed, without a mismatch', () => {
+    const oldReset = T0 + 10 * MINUTE_MS;
+    const observations = [obs(0, 10, oldReset), obs(12, 2, RESET), obs(30, 4, RESET)];
+    const result = checked(projectQuota(observations, new Date(T0 + 31 * MINUTE_MS)));
+    expect(result).toMatchObject({ status: 'available', observedFrom: iso(T0 + 12 * MINUTE_MS) });
+  });
+
+  it('tolerates a resetsAt shift of exactly 60 seconds', () => {
+    const observations = [obs(0, 10, RESET), obs(20, 30, RESET + QUOTA_RESET_TOLERANCE_MS)];
+    expect(checked(projectQuota(observations, NOW)).status).toBe('available');
+  });
+});
+
+describe('projectQuota monotonicity and growth', () => {
+  it('returns reset_mismatch when the percent drops inside a window', () => {
+    expect(checked(projectQuota([obs(0, 40), obs(10, 30), obs(20, 50)], NOW)).reason).toBe('reset_mismatch');
+  });
+
+  it('returns not_increasing for a flat percent', () => {
+    expect(checked(projectQuota([obs(0, 40), obs(20, 40)], NOW)).reason).toBe('not_increasing');
+  });
+
+  it('returns not_increasing for a window already at 100 percent throughout', () => {
+    expect(checked(projectQuota([obs(0, 100), obs(20, 100)], NOW)).reason).toBe('not_increasing');
+  });
+
+  it('returns not_increasing when the growth pushes exhaustion past the 2100 horizon', () => {
+    expect(checked(projectQuota([obs(0, 0), obs(10, 0.000001)], NOW)).reason).toBe('not_increasing');
+  });
+
+  it('returns exhaustedAt equal to the last observation when the window reaches 100 percent', () => {
+    const result = checked(projectQuota([obs(0, 90), obs(20, 100)], NOW));
+    expect(result).toEqual({
+      status: 'available',
+      exhaustedAt: iso(T0 + 20 * MINUTE_MS),
+      observedFrom: iso(T0),
+      observedTo: iso(T0 + 20 * MINUTE_MS),
+      fiabilite: 'estime',
+      resetsBeforeExhaustion: false,
+    });
+  });
+});
+
+describe('projectQuota computation', () => {
+  it('returns insufficient_data for a single fresh observation', () => {
+    expect(checked(projectQuota([obs(0, 10)], NOW)).reason).toBe('insufficient_data');
+  });
+
+  it('returns insufficient_data for two observations less than 10 minutes apart', () => {
+    expect(checked(projectQuota([obs(0, 10), obs(9, 30)], new Date(T0 + 10 * MINUTE_MS))).reason).toBe('insufficient_data');
+  });
+
+  it('accepts two observations exactly 10 minutes apart', () => {
+    expect(checked(projectQuota([obs(0, 10), obs(10, 30)], new Date(T0 + 11 * MINUTE_MS))).status).toBe('available');
+  });
+
+  it('extrapolates linearly between the first and last observation of the window', () => {
+    expect(checked(projectQuota([obs(0, 10), obs(20, 30)], NOW))).toEqual({
+      status: 'available',
+      exhaustedAt: '2026-10-18T11:30:00.000Z',
+      observedFrom: '2026-10-18T10:00:00.000Z',
+      observedTo: '2026-10-18T10:20:00.000Z',
+      fiabilite: 'estime',
+      resetsBeforeExhaustion: false,
+    });
+  });
+
+  it('ignores middle observations: only the first and last of the window set the slope', () => {
+    const straight = checked(projectQuota([obs(0, 10), obs(20, 30)], NOW));
+    const bumpy = checked(projectQuota([obs(0, 10), obs(5, 12), obs(10, 20), obs(20, 30)], NOW));
+    expect(bumpy).toEqual(straight);
+  });
+
+  it('sets resetsBeforeExhaustion when exhaustion falls after the reset', () => {
+    const reset = T0 + 1 * HOUR_MS;
+    expect(checked(projectQuota([obs(0, 10, reset), obs(20, 30, reset)], NOW))).toMatchObject({
+      status: 'available',
+      exhaustedAt: '2026-10-18T11:30:00.000Z',
+      resetsBeforeExhaustion: true,
+    });
+  });
+
+  it('treats an exhaustion exactly on the reset as not before it', () => {
+    const reset = Date.parse('2026-10-18T11:30:00.000Z');
+    expect(checked(projectQuota([obs(0, 10, reset), obs(20, 30, reset)], NOW))).toMatchObject({
+      status: 'available',
+      resetsBeforeExhaustion: false,
+    });
+  });
+});
+
+describe('projectQuota ordering and volume', () => {
+  it('gives the same result whatever the order of the observations', () => {
+    const ordered = [obs(0, 10), obs(10, 20), obs(20, 30)];
+    const shuffled = [obs(10, 20), obs(20, 30), obs(0, 10)];
+    expect(projectQuota(shuffled, NOW)).toEqual(projectQuota(ordered, NOW));
+  });
+
+  it('processes 20 000 observations without error', () => {
+    const count = 20_000;
+    const observations = Array.from({ length: count }, (_value, index) => ({
+      at: iso(T0 + index * 1000), percent: index / 100_000, resetsAt: iso(T0 + 10 * HOUR_MS),
+    }));
+    const now = new Date(T0 + (count - 1) * 1000 + MINUTE_MS);
+    expect(checked(projectQuota(observations, now)).status).toBe('available');
+  });
+});
