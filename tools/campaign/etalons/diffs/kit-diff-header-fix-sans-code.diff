+        self.project.mkdir()
+        self.git('init', '-q', '-b', 'initial')
+        (self.project / 'calc.py').write_text('def add(a, b):\n    return a + b\n')
+        self.git('add', '.')
+        self.git('commit', '-qm', 'base')
+        self.commit = self.git('rev-parse', 'HEAD').strip()
+
+    def git(self, *args):
+        done = subprocess.run(['git'] + list(args), cwd=str(self.project), env=dict(os.environ, **IDENTITY),
+                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT, universal_newlines=True)
+        self.assertEqual(done.returncode, 0, done.stdout)
+        return done.stdout
+
+    def test_old_diff_is_harvested_as_applicable_etalon(self):
+        state = self.project / '.workspace/orchestration/tasks/calc-old'
+        run = self.project / '.workspace/run/delegate/calc-old'
+        state.mkdir(parents=True)
+        run.mkdir(parents=True)
+        (self.project / 'tasks').mkdir()
+        (self.project / 'tasks/calc-old.md').write_text(
+            '---\nid: calc-old\nagent: codex\nallowed: [calc.py, "tests/**"]\nacceptance: [eval/test_eval.py]\n'
+            'acceptance_verify: python3 -m unittest discover -s eval\n---\n# Fiche\n')
+        hidden = self.project / '.workspace/acceptance/calc-old/eval'
+        hidden.mkdir(parents=True)
+        (hidden / 'test_eval.py').write_text('import unittest\n\n\nclass E(unittest.TestCase):\n    pass\n')
+        (state / 'state.json').write_text(json.dumps(dict(
+            task_id='calc-old', agent='codex', status='merged', created_at='2026-10-10T10:00:00Z',
+            base_commit=self.commit, source_task='tasks/calc-old.md')))
+        (run / 'diff.txt').write_bytes(OLD_DIFF)
+        out = Path(self.tmp.name) / 'jeu'
+        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
+            code = etalons_harvest.main(['--harvest', str(self.project), '--out', str(out)])
+        self.assertEqual(code, 0)
+        written = (out / 'diffs/demo-project-calc-old-bon.diff').read_bytes()
+        self.assertTrue(written.startswith(b'diff --git a/'))
+        self.assertNotIn(b'100600', written)
+        done = subprocess.run(['git', 'apply', '--check', '-'], cwd=str(self.project), input=written,
+                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+        self.assertEqual(done.returncode, 0, done.stdout)
+
+
+if __name__ == '__main__':
+    unittest.main()
