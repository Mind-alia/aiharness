+
+IDENTITY = dict(GIT_AUTHOR_NAME='Test', GIT_AUTHOR_EMAIL='test@example.org',
+                GIT_COMMITTER_NAME='Test', GIT_COMMITTER_EMAIL='test@example.org')
+OLD_DIFF = (b'diff --git/notes.txt b/notes.txt\nnew file mode 100600\n--- /dev/null\n+++ b/notes.txt\n'
+            b'@@ -0,0 +1 @@\n+hello\n')
