+@unittest.skipIf(shutil.which('git') is None, 'git absent')
+class BuildDiffTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.base = Path(self.tmp.name) / 'base'
+        self.work = Path(self.tmp.name) / 'work'
+        self.base.mkdir()
+        self.git('init', '-q', '-b', 'initial', str(self.base))
+        write(self.base, 'edit.txt', 'one\ntwo\n', 0o644)
+        write(self.base, 'gone.txt', 'bye\n', 0o644)
+        write(self.base, 'secret.txt', 'key\n', 0o644)
+        write(self.base, 'run.sh', 'echo hi\n', 0o644)
+        self.git('-C', str(self.base), 'add', '.')
+        self.git('-C', str(self.base), 'commit', '-qm', 'base')
+        shutil.copytree(str(self.base), str(self.work), symlinks=True, ignore=shutil.ignore_patterns('.git'))
+
+    def git(self, *args):
+        done = subprocess.run(['git'] + list(args), env=dict(os.environ, **IDENTITY),
+                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+        self.assertEqual(done.returncode, 0, done.stdout)
+        return done.stdout
+
+    def change(self, name, text, mode=None):
+        write(self.work, name, text, mode if mode is not None else 0o644)
+
+    def diff_of(self, names, baseline):
+        initial = delegate_run.capture_initial(baseline, self.base, [])
+        return bytes(delegate_run.build_diff(names, self.work, initial, baseline, []))
+
+    def replay(self, diff, *options):
+        """Rejoue le diff sur une copie fraîche de la base ; renvoie le dossier rejoué."""
+        replay = Path(self.tmp.name) / 'replay'
+        shutil.copytree(str(self.base), str(replay), symlinks=True, ignore=shutil.ignore_patterns('.git'))
+        done = subprocess.run(['git', 'apply'] + list(options) + ['-'], cwd=str(replay), input=diff,
+                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+        self.assertEqual(done.returncode, 0, done.stdout)
+        return replay
+
+    def test_build_diff_applies_with_git(self):
+        names = ['edit.txt', 'gone.txt', 'run.sh', 'created.txt']
+        baseline = {name: fingerprint(self.base / name) for name in names if (self.base / name).exists()}
+        self.change('edit.txt', 'one\nthree\n')
+        (self.work / 'gone.txt').unlink()
+        self.change('run.sh', 'echo hi\n', 0o755)
+        self.change('created.txt', 'new\n', 0o600)
+        diff = self.diff_of(names, baseline)
+
+        self.assertIn(b'diff --git a/created.txt b/created.txt\nnew file mode 100644\n', diff)
+        self.assertIn(b'old mode 100644\nnew mode 100755\n', diff)
+        self.assertNotIn(b'diff --git/', diff)
+        self.assertNotIn(b'100600', diff)
+        replay = self.replay(diff)
+        self.assertEqual((replay / 'edit.txt').read_text(), 'one\nthree\n')
+        self.assertFalse((replay / 'gone.txt').exists())
+        self.assertEqual((replay / 'created.txt').read_text(), 'new\n')
+        self.assertTrue(os.stat(str(replay / 'run.sh')).st_mode & stat.S_IXUSR)
+
+    def test_mode_change_without_execute_bit_writes_no_mode_line(self):
+        baseline = {'secret.txt': fingerprint(self.base / 'secret.txt')}
+        self.change('secret.txt', 'key\n', 0o600)
+        diff = self.diff_of(['secret.txt'], baseline)
+        self.assertEqual(diff, b'diff --git a/secret.txt b/secret.txt\n')
+        self.replay(diff, '--allow-empty')
+
