+        (self.root / events.LOCK_PATH).mkdir(parents=True)
+        self.assertIsNone(self.orchestrator_of_new_line())
+
+    def test_every_line_carries_the_orchestrator_key(self):
+        self.put_lock(json.dumps({'session': 'usine-1'}))
