+import { describe, expect, it } from 'vitest';
+import {
+  QUOTA_PROJECTION_UNKNOWN_REASONS, QuotaProjectionSchema, QuotaProjectionUnknownReasonSchema, UsageWindowSchema,
+} from './index.js';
+
+const available = {
+  status: 'available', exhaustedAt: '2026-10-18T11:30:00.000Z', observedFrom: '2026-10-18T10:00:00.000Z',
+  observedTo: '2026-10-18T10:20:00.000Z', fiabilite: 'estime', resetsBeforeExhaustion: false,
+};
+const unknown = { status: 'unknown', reason: 'insufficient_data', fiabilite: 'inconnu' };
+
+describe('quota projection contract', () => {
+  it('accepts an available projection and each unknown reason', () => {
+    expect(QuotaProjectionSchema.parse(available)).toEqual(available);
+    for (const reason of QUOTA_PROJECTION_UNKNOWN_REASONS) {
+      expect(QuotaProjectionSchema.parse({ ...unknown, reason })).toEqual({ ...unknown, reason });
+    }
+    expect(QuotaProjectionUnknownReasonSchema.options).toEqual([
+      'insufficient_data', 'stale', 'not_increasing', 'reset_mismatch', 'invalid',
+    ]);
+  });
+
+  it('accepts an exhaustion instant equal to the last observation', () => {
+    const atLast = { ...available, exhaustedAt: available.observedTo };
+    expect(QuotaProjectionSchema.safeParse(atLast).success).toBe(true);
+  });
+
+  it('refuses an exhaustion before the last observation', () => {
+    const early = { ...available, exhaustedAt: '2026-10-18T10:19:59.999Z' };
+    expect(QuotaProjectionSchema.safeParse(early).success).toBe(false);
+  });
+
+  it('refuses an observed span that is not strictly increasing', () => {
+    expect(QuotaProjectionSchema.safeParse({ ...available, observedFrom: available.observedTo }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...available, observedFrom: '2026-10-18T10:30:00.000Z' }).success).toBe(false);
+  });
+
+  it('compares instants rather than strings when the fractions differ', () => {
+    const fractional = { ...available, observedFrom: '2026-10-18T10:00:00.5Z', observedTo: '2026-10-18T10:00:00.25Z' };
+    expect(QuotaProjectionSchema.safeParse(fractional).success).toBe(false);
+  });
+
+  it('refuses dates that are not UTC with a Z suffix', () => {
+    expect(QuotaProjectionSchema.safeParse({ ...available, exhaustedAt: '2026-10-18T13:30:00+02:00' }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...available, observedFrom: '2026-10-18' }).success).toBe(false);
+  });
+
+  it('refuses an unknown reason, status or fiabilite', () => {
+    expect(QuotaProjectionSchema.safeParse({ ...unknown, reason: 'other' }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...unknown, status: 'pending' }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...unknown, fiabilite: 'estime' }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...available, fiabilite: 'inconnu' }).success).toBe(false);
+  });
+
+  it('keeps variants strict: no dates or booleans on unknown, no reason on available', () => {
+    expect(QuotaProjectionSchema.safeParse({ ...unknown, observedTo: available.observedTo }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...unknown, resetsBeforeExhaustion: false }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...available, reason: 'stale' }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...available, extra: true }).success).toBe(false);
+  });
+
+  it('requires every field of each variant', () => {
+    const withoutExhaustion = Object.fromEntries(Object.entries(available).filter(([key]) => key !== 'exhaustedAt'));
+    expect(QuotaProjectionSchema.safeParse(withoutExhaustion).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ status: 'unknown', fiabilite: 'inconnu' }).success).toBe(false);
+  });
+});
+
+describe('usage window projection field', () => {
+  const window = {
+    id: 'five_hour', percent: 30, resetsAt: '2026-10-18T15:00:00.000Z', fiabilite: 'mesure',
+    observedAt: '2026-10-18T10:20:00.000Z',
+  };
+
+  it('accepts a window without projection, meaning not computed', () => {
+    expect(UsageWindowSchema.parse(window)).toEqual(window);
+  });
+
+  it('accepts a window carrying a valid projection', () => {
+    expect(UsageWindowSchema.parse({ ...window, projection: available })).toEqual({ ...window, projection: available });
+  });
+
+  it('refuses a null projection and an invalid projection inside a window', () => {
+    expect(UsageWindowSchema.safeParse({ ...window, projection: null }).success).toBe(false);
+    expect(UsageWindowSchema.safeParse({ ...window, projection: { ...unknown, extra: 1 } }).success).toBe(false);
+  });
+
+  it('keeps the window strict around the new field', () => {
+    expect(UsageWindowSchema.safeParse({ ...window, forecast: available }).success).toBe(false);
+  });
+});
