@@ -0,0 +1,77 @@
+import { describe, expect, it } from 'vitest';
+import { QuotaProjectionSchema, UsageWindowSchema } from './usage.js';
+
+const available = {
+  status: 'available',
+  exhaustedAt: '2026-10-18T14:20:00.000Z',
+  observedFrom: '2026-10-18T11:20:00.000Z',
+  observedTo: '2026-10-18T11:50:00.000Z',
+  fiabilite: 'estime',
+  resetsBeforeExhaustion: false,
+} as const;
+const unknown = { status: 'unknown', reason: 'stale', fiabilite: 'inconnu' } as const;
+const window = {
+  id: 'five_hour',
+  percent: 50,
+  resetsAt: '2026-10-18T15:00:00Z',
+  fiabilite: 'mesure',
+  observedAt: '2026-10-18T11:50:00Z',
+} as const;
+
+describe('QuotaProjectionSchema', () => {
+  it('accepts both variants', () => {
+    expect(QuotaProjectionSchema.parse(available)).toEqual(available);
+    for (const reason of ['insufficient_data', 'stale', 'not_increasing', 'reset_mismatch', 'invalid']) {
+      expect(QuotaProjectionSchema.safeParse({ ...unknown, reason }).success).toBe(true);
+    }
+  });
+
+  it('accepts fractional seconds and equal bounds', () => {
+    const instant = '2026-10-18T11:20:00.123456Z';
+    const projection = { ...available, exhaustedAt: instant, observedFrom: instant, observedTo: instant };
+    expect(QuotaProjectionSchema.safeParse(projection).success).toBe(true);
+  });
+
+  it('refuses unknown fields on both variants', () => {
+    expect(QuotaProjectionSchema.safeParse({ ...available, extra: 1 }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...unknown, extra: 1 }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...unknown, exhaustedAt: available.exhaustedAt }).success).toBe(false);
+  });
+
+  it('refuses missing fields, foreign reliabilities, statuses and reasons', () => {
+    const withoutFlag = Object.fromEntries(Object.entries(available).filter(([key]) => key !== 'resetsBeforeExhaustion'));
+    expect(QuotaProjectionSchema.safeParse(withoutFlag).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ status: 'unknown', fiabilite: 'inconnu' }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...available, fiabilite: 'inconnu' }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...available, fiabilite: 'mesure' }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...unknown, fiabilite: 'estime' }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...unknown, reason: 'other' }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...unknown, status: 'pending' }).success).toBe(false);
+  });
+
+  it('refuses dates without a UTC suffix', () => {
+    for (const exhaustedAt of ['2026-10-18T14:20:00', '2026-10-18T16:20:00+02:00', '2026-10-18', 'demain']) {
+      expect(QuotaProjectionSchema.safeParse({ ...available, exhaustedAt }).success).toBe(false);
+    }
+  });
+
+  it('refuses incoherent dates', () => {
+    expect(QuotaProjectionSchema.safeParse({ ...available, observedFrom: '2026-10-18T11:51:00.000Z' }).success)
+      .toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...available, exhaustedAt: '2026-10-18T11:19:59.999Z' }).success)
+      .toBe(false);
+  });
+});
+
+describe('UsageWindowSchema projection', () => {
+  it('accepts a window without projection or with either variant', () => {
+    expect(UsageWindowSchema.safeParse(window).success).toBe(true);
+    expect(UsageWindowSchema.parse({ ...window, projection: available }).projection).toEqual(available);
+    expect(UsageWindowSchema.parse({ ...window, projection: unknown }).projection).toEqual(unknown);
+  });
+
+  it('refuses a null or invalid projection', () => {
+    expect(UsageWindowSchema.safeParse({ ...window, projection: null }).success).toBe(false);
+    expect(UsageWindowSchema.safeParse({ ...window, projection: { ...unknown, reason: 'other' } }).success).toBe(false);
+  });
+});
