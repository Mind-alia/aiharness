--- a/AGENTS.md
+++ b/AGENTS.md
@@ -1,4 +1,8 @@
 # Règles pour travailler sur le kit Workspace IA
+
+docs-check: kit
+
+La ligne ci-dessus fait vérifier à `scripts/docs-check.sh` seulement ce mode kit : `AGENTS.md` (80 lignes au plus), `docs/LOG.md`, `docs/AMELIORATIONS.md` et `docs/QUESTIONS.md`.
 
 Ce dépôt est le moteur : `template/` est copié dans chaque projet, `scripts/` est son miroir pour que le kit se pilote lui-même, `tests/` est la suite (Python 3.9, bibliothèque standard). Lire `README.md`, `docs/LOG.md` (dernières entrées) et `docs/AMELIORATIONS.md` (état par statut) avant de toucher au code.
 
diff --git a/template/scripts/docs-check.sh b/template/scripts/docs-check.sh
--- a/template/scripts/docs-check.sh
+++ b/template/scripts/docs-check.sh
@@ -4,6 +4,16 @@
 cd "$(dirname "$0")/.." || exit 2
 fail=0
 err() { echo "DOCS FAIL: $*"; fail=1; }
+
+# Kit mode: a project declaring `docs-check: kit` in AGENTS.md has no STATUS or plans, only these documents.
+if grep -qx 'docs-check: kit' AGENTS.md; then
+  [ "$(wc -l < AGENTS.md)" -le 80 ] || err "AGENTS.md longer than 80 lines"
+  for doc in docs/LOG.md docs/AMELIORATIONS.md docs/QUESTIONS.md; do
+    [ -f "$doc" ] || err "$doc missing"
+  done
+  [ $fail -eq 0 ] && echo "docs: OK"
+  exit $fail
+fi
 
