@@ -0,0 +1,76 @@
+import { describe, expect, it } from 'vitest';
+import { QUOTA_PROJECTION_REASONS, QuotaProjectionSchema, UsageWindowSchema } from './usage.js';
+
+const available = {
+  status: 'available',
+  exhaustedAt: '2026-10-18T13:40:00.000Z',
+  observedFrom: '2026-10-18T11:00:00.000Z',
+  observedTo: '2026-10-18T12:00:00.000Z',
+  fiabilite: 'estime',
+  resetsBeforeExhaustion: false,
+};
+const unknown = { status: 'unknown', reason: 'stale', fiabilite: 'inconnu' };
+const window = {
+  id: 'five_hour',
+  percent: 50,
+  resetsAt: '2026-10-18T15:00:00.000Z',
+  fiabilite: 'mesure',
+  observedAt: '2026-10-18T12:00:00.000Z',
+};
+
+describe('quota projection contract', () => {
+  it('accepts the available variant and every closed reason of the unknown variant', () => {
+    expect(QuotaProjectionSchema.parse(available)).toEqual(available);
+    expect(QUOTA_PROJECTION_REASONS).toEqual(['insufficient_data', 'stale', 'not_increasing', 'reset_mismatch', 'invalid']);
+    for (const reason of QUOTA_PROJECTION_REASONS) {
+      expect(QuotaProjectionSchema.safeParse({ ...unknown, reason }).success).toBe(true);
+    }
+  });
+
+  it('rejects unknown fields and fields of the other variant', () => {
+    expect(QuotaProjectionSchema.safeParse({ ...available, extra: 1 }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...unknown, extra: 1 }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...available, reason: 'stale' }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...unknown, exhaustedAt: available.exhaustedAt }).success).toBe(false);
+  });
+
+  it('rejects a missing field, another fiabilite, status or reason', () => {
+    expect(QuotaProjectionSchema.safeParse({ ...available, resetsBeforeExhaustion: undefined }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...available, resetsBeforeExhaustion: 'false' }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...available, fiabilite: 'mesure' }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...available, fiabilite: 'inconnu' }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...unknown, fiabilite: 'estime' }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...unknown, status: 'pending' }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...unknown, reason: 'other' }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ status: 'unknown', fiabilite: 'inconnu' }).success).toBe(false);
+  });
+
+  it('accepts UTC dates with Z only', () => {
+    expect(QuotaProjectionSchema.safeParse({ ...available, exhaustedAt: '2026-10-18T15:40:00+02:00' }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...available, observedFrom: '2026-10-18' }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...available, observedTo: '2026-10-18T12:00:00' }).success).toBe(false);
+  });
+
+  it('requires observedFrom ≤ observedTo ≤ exhaustedAt, comparing instants', () => {
+    expect(QuotaProjectionSchema.safeParse({ ...available, observedFrom: '2026-10-18T12:00:01Z' }).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...available, exhaustedAt: '2026-10-18T11:59:59Z' }).success).toBe(false);
+    const equal = { ...available, observedFrom: '2026-10-18T12:00:00Z', observedTo: '2026-10-18T12:00:00.000Z', exhaustedAt: '2026-10-18T12:00:00.0Z' };
+    expect(QuotaProjectionSchema.safeParse(equal).success).toBe(true);
+  });
+
+  it('compares instants beyond the millisecond', () => {
+    const sameMs = { ...available, observedTo: '2026-10-18T12:00:00.0009Z', exhaustedAt: '2026-10-18T12:00:00.0001Z' };
+    expect(QuotaProjectionSchema.safeParse(sameMs).success).toBe(false);
+    expect(QuotaProjectionSchema.safeParse({ ...sameMs, observedFrom: '2026-10-18T12:00:00.00010Z', observedTo: '2026-10-18T12:00:00.0001Z' }).success).toBe(true);
