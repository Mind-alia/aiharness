 export type UsageWindowId = z.infer<typeof UsageWindowIdSchema>;
 
+/** Linear estimate of when a window reaches 100 %, or an explicit unknown with its reason. */
+export const QuotaProjectionSchema = z.discriminatedUnion('status', [
+  z.strictObject({
+    status: z.literal('available'),
+    exhaustedAt: z.iso.datetime(),
+    observedFrom: z.iso.datetime(),
+    observedTo: z.iso.datetime(),
+    fiabilite: z.literal('estime'),
