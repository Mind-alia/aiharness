+++ b/template/scripts/lib/orchestrator.py
@@ -0,0 +1,233 @@
+"""Verrou d'orchestration déclaratif et état d'ensemble (Python 3.9, stdlib seule).
+
+`claim` déclare qu'une session orchestre ce dépôt dans `.workspace/orchestrator.json`,
+`release` retire la déclaration, `status` résume verrou, tâches actives, conteneurs et
+processus d'agents. Le verrou n'empêche aucune autre commande : il ne fait que se voir.
+"""
+from __future__ import annotations
+
+import argparse
+import datetime
+import json
+import os
+from pathlib import Path
+import shutil
+import socket
+import subprocess
+import sys
+import tempfile
+
+import events
+import safety
+
+sys.dont_write_bytecode = True
+
+LOCK_PATH = '.workspace/orchestrator.json'
+TASKS_GLOB = '.workspace/orchestration/tasks/*/state.json'
+ORCHESTRATOR_ID = 'orchestrator'
+ACTIVE_STATUSES = ('prepared', 'running', 'merge_conflict', 'integration_failed')
+PROCESS_MARKERS = ('claude -p', 'codex', 'campaign.py')
+COMMAND_LIMIT = 160
+SUBPROCESS_TIMEOUT = 10
+EXIT_HELD = 3
+EXIT_USAGE = 64
+USAGE = ('usage : orchestrator.sh claim [--session NOM] [--model NOM] [--repos CHEMIN[,CHEMIN...]] '
+         '[--pid N] [--force]\n        orchestrator.sh release\n        orchestrator.sh status')
+
+
+def _lock_path(root):
+    path = root / LOCK_PATH
+    safety.check_no_symlinks(path, root)
+    return path
+
+
+def _read_lock(path):
+    """Contenu du verrou, ou `None` s'il est illisible ou n'est pas un objet JSON."""
+    try:
+        data = json.loads(path.read_text(encoding='utf-8'))
+    except (OSError, ValueError):
+        return None
+    return data if isinstance(data, dict) else None
+
+
+def _write_atomic(path, data):
+    fd, temp = tempfile.mkstemp(dir=str(path.parent), prefix='.orchestrator-', suffix='.tmp')
+    try:
+        with os.fdopen(fd, 'w', encoding='utf-8') as stream:
+            stream.write(json.dumps(data, ensure_ascii=False, indent=2) + '\n')
+        os.chmod(temp, 0o600)
+        os.replace(temp, path)
+    except BaseException:
+        try:
+            os.unlink(temp)
+        except OSError:
+            pass
+        raise
+
+
+def claim(root, args):
+    path = _lock_path(root)
+    if os.path.lexists(path) and not args.force:
+        held = _read_lock(path)
+        name = held.get('session') if held else None
+        print('verrou déjà pris par la session %s ; --force pour le remplacer' % (name or 'inconnue'),
+              file=sys.stderr)
+        return EXIT_HELD
+    pid = args.pid if args.pid is not None else os.getppid()
+    data = {
+        'session': args.session or '%s-%d' % (socket.gethostname(), pid),
+        'model': args.model or 'inconnu',
+        'started_at': datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
+        'pid': pid,
+        'repos': [item.strip() for item in args.repos.split(',') if item.strip()] if args.repos else [str(root)],
+    }
+    if not path.parent.exists():
+        path.parent.mkdir(mode=0o700)
+    _write_atomic(path, data)
+    events.record(root, ORCHESTRATOR_ID, 'orchestrator_claimed',
+                  {'session': data['session'], 'model': data['model'], 'pid': pid})
+    print('verrou pris : %s (%s)' % (data['session'], data['model']))
+    return 0
+
+
+def release(root, _args):
+    path = _lock_path(root)
+    if not os.path.lexists(path):
+        print('aucun verrou')
+        return 0
+    held = _read_lock(path)
+    path.unlink()
+    events.record(root, ORCHESTRATOR_ID, 'orchestrator_released',
+                  {'session': held.get('session') if held else None})
+    print('verrou libéré')
+    return 0
+
+
+def _pid_alive(pid):
+    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
+        return False
+    try:
+        os.kill(pid, 0)
+    except PermissionError:
+        return True
+    except OSError:
+        return False
+    return True
+
+
+def _lock_line(root):
+    path = _lock_path(root)
+    if not os.path.lexists(path):
+        return 'verrou : aucun'
+    held = _read_lock(path)
+    if held is None:
+        return 'verrou : illisible'
+    state = 'vivant' if _pid_alive(held.get('pid')) else 'terminé'
+    return 'verrou : %s (%s) depuis %s, pid %s (%s)' % (
+        held.get('session'), held.get('model'), held.get('started_at'), held.get('pid'), state)
+
+
+def _task_lines(root):
+    lines = []
+    for state_file in sorted(root.glob(TASKS_GLOB)):
+        try:
+            safety.check_no_symlinks(state_file, root)
+            data = json.loads(state_file.read_text(encoding='utf-8'))
+            status = data['status'] if isinstance(data, dict) else None
+        except (OSError, ValueError, KeyError):
+            status = None
+        if not isinstance(status, str):
+            lines.append('tâche illisible : %s' % state_file.parent.name)
+        elif status in ACTIVE_STATUSES:
+            lines.append('tâche active : %s (%s)' % (state_file.parent.name, status))
+    return lines or ['tâches actives : aucune']
+
+
+def _container_lines():
+    command = ['docker', 'ps', '--filter', 'name=workspace-sandbox-', '--format', '{{.Names}}']
+    try:
+        done = subprocess.run(command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
+                              stderr=subprocess.DEVNULL, universal_newlines=True, timeout=SUBPROCESS_TIMEOUT)
+    except (OSError, subprocess.SubprocessError):
+        return ['conteneurs : docker indisponible']
+    if done.returncode != 0:
+        return ['conteneurs : docker indisponible']
+    names = [line.strip() for line in done.stdout.splitlines() if line.strip()]
+    return ['conteneur : ' + name for name in names] or ['conteneurs : aucun']
+
+
+def _list_processes():
+    """Couples (pid, ligne de commande) : `ps` s'il existe, sinon `/proc`."""
+    found = []
+    if shutil.which('ps'):
+        done = subprocess.run(['ps', '-eo', 'pid=,args='], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
+                              stderr=subprocess.DEVNULL, universal_newlines=True, timeout=SUBPROCESS_TIMEOUT)
+        for line in done.stdout.splitlines():
+            pid, _, command = line.strip().partition(' ')
+            if pid.isdigit() and command.strip():
+                found.append((int(pid), command.strip()))
+        return found
+    for entry in Path('/proc').iterdir():
+        if not entry.name.isdigit():
+            continue
+        try:
+            raw = (entry / 'cmdline').read_bytes()
+        except OSError:
+            continue
+        command = raw.replace(b'\0', b' ').decode('utf-8', errors='replace').strip()
+        if command:
+            found.append((int(entry.name), command))
+    return found
+
+
+def _process_lines():
+    own = {os.getpid(), os.getppid()}
+    try:
+        processes = _list_processes()
+    except (OSError, subprocess.SubprocessError):
+        processes = []
+    lines = ['processus : %d %s' % (pid, ' '.join(command.split())[:COMMAND_LIMIT])
+             for pid, command in processes
+             if pid not in own and any(marker in command for marker in PROCESS_MARKERS)]
+    return lines or ['processus : aucun']
+
+
+def status(root, _args):
+    for line in [_lock_line(root)] + _task_lines(root) + _container_lines() + _process_lines():
+        print(line)
+    return 0
+
+
+def _claim_parser():
+    parser = argparse.ArgumentParser(prog='orchestrator.sh claim')
+    parser.add_argument('--session')
+    parser.add_argument('--model')
+    parser.add_argument('--repos', help='chemins séparés par des virgules')
+    parser.add_argument('--pid', type=int)
+    parser.add_argument('--force', action='store_true')
+    return parser
+
+
+def main(argv):
+    for stream in (sys.stdout, sys.stderr):
+        stream.reconfigure(encoding='utf-8', errors='replace')
+    if len(argv) < 3 or argv[2] not in ('claim', 'release', 'status'):
+        print(USAGE, file=sys.stderr)
+        return EXIT_USAGE
+    root, command, rest = Path(argv[1]), argv[2], argv[3:]
+    if command == 'claim':
+        args = _claim_parser().parse_args(rest)
+    elif rest:
+        print(USAGE, file=sys.stderr)
+        return EXIT_USAGE
+    else:
+        args = None
+    try:
+        return {'claim': claim, 'release': release, 'status': status}[command](root, args)
+    except (OSError, ValueError) as error:
+        print('orchestrator: ' + str(error).replace('\n', ' '), file=sys.stderr)
+        return 1
+
+
+if __name__ == '__main__':
+    sys.exit(main(sys.argv))
