--- /dev/null
+++ b/apps/service/src/domain/usage/quota-projection.test.ts
@@ -0,0 +1,236 @@
+import { QuotaProjectionSchema, type QuotaProjection } from '@wsc/contracts';
+import { describe, expect, it } from 'vitest';
+import { projectQuota } from './quota-projection.js';
+
+type Observation = { at: string; percent: number; resetsAt: string };
+
+const RESET = '2026-10-18T15:00:00Z';
+const NOW = new Date('2026-10-18T12:00:00Z');
+
+function obs(time: string, percent: number, resetsAt = RESET): Observation {
+  return { at: `2026-10-18T${time}Z`, percent, resetsAt };
+}
+
+/** Every result must satisfy the contract, whatever the rule that produced it. */
+function project(observations: readonly unknown[], now = NOW): QuotaProjection {
+  const result = projectQuota(observations as readonly Observation[], now);
+  expect(QuotaProjectionSchema.safeParse(result).success).toBe(true);
+  return result;
+}
+
+function unknown(reason: string) {
+  return { status: 'unknown', reason, fiabilite: 'inconnu' };
+}
+
+const reference = [obs('11:20:00', 40), obs('11:50:00', 50)];
+const referenceResult = {
+  status: 'available',
+  exhaustedAt: '2026-10-18T14:20:00.000Z',
+  observedFrom: '2026-10-18T11:20:00.000Z',
+  observedTo: '2026-10-18T11:50:00.000Z',
+  fiabilite: 'estime',
+  resetsBeforeExhaustion: false,
+};
+
+describe('projectQuota', () => {
+  it('projects the reference example linearly', () => {
+    expect(project(reference)).toStrictEqual(referenceResult);
+  });
+
+  describe('rule 1: invalid now', () => {
+    it('answers invalid before anything else', () => {
+      const invalidNow = new Date('nope');
+      expect(project([], invalidNow)).toStrictEqual(unknown('invalid'));
+      expect(project(reference, invalidNow)).toStrictEqual(unknown('invalid'));
+    });
+  });
+
+  describe('rule 2: observation validation', () => {
+    it.each([120, -1, Number.NaN, Number.POSITIVE_INFINITY, '50'])('refuses percent %s', percent => {
+      expect(project([reference[0], { ...obs('11:50:00', 0), percent }])).toStrictEqual(unknown('invalid'));
+    });
+
+    it('accepts the percent bounds', () => {
+      expect(project([obs('11:40:00', 0), obs('11:50:00', 0)])).toStrictEqual(unknown('not_increasing'));
+      expect(project([obs('11:50:00', 100)]).status).toBe('available');
+    });
+
+    it.each(['pas une date', '2026-10-18T11:20:00', '2026-10-18', '1999-12-31T23:59:59Z', '2100-01-01T00:00:00Z', 42])(
+      'refuses date %s in at and resetsAt',
+      date => {
+        expect(project([{ ...reference[0], at: date }, reference[1]])).toStrictEqual(unknown('invalid'));
+        expect(project([{ ...reference[0], resetsAt: date }, reference[1]])).toStrictEqual(unknown('invalid'));
+      },
+    );
+
+    it('refuses unknown or missing keys and non-objects', () => {
+      const missing = { at: reference[1].at, resetsAt: reference[1].resetsAt };
+      for (const bad of [{ ...reference[1], extra: 1 }, missing, null, 'obs', [1, 2, 3]]) {
+        expect(project([reference[0], bad])).toStrictEqual(unknown('invalid'));
+      }
+    });
+
+    it('validates observations of previous windows too', () => {
+      const previous = { ...obs('10:00:00', 90, '2026-10-18T11:00:00Z'), percent: 101 };
+      expect(project([previous, ...reference])).toStrictEqual(unknown('invalid'));
+    });
+
+    it('tolerates 60 s of clock skew only', () => {
+      expect(project([obs('11:50:00', 40), obs('12:00:30', 50)]).status).toBe('available');
+      expect(project([obs('11:50:00', 40), obs('12:01:01', 50)])).toStrictEqual(unknown('invalid'));
+    });
+  });
+
+  describe('rule 3: duplicates', () => {
+    it('counts an identical duplicate once', () => {
+      expect(project([...reference, { ...reference[1] }])).toStrictEqual(referenceResult);
+      expect(project([obs('11:50:00', 50), obs('11:50:00', 50)])).toStrictEqual(unknown('insufficient_data'));
+    });
+
+    it('treats offsets of the same instant as duplicates', () => {
+      const shifted = { at: '2026-10-18T13:50:00+02:00', percent: 50, resetsAt: '2026-10-18T17:00:00+02:00' };
+      expect(project([...reference, shifted])).toStrictEqual(referenceResult);
+    });
+
+    it('refuses the same instant with a different percent or reset', () => {
+      expect(project([...reference, obs('11:50:00', 51)])).toStrictEqual(unknown('invalid'));
+      expect(project([...reference, obs('11:50:00', 50, '2026-10-18T15:00:30Z')])).toStrictEqual(unknown('invalid'));
+    });
+  });
+
+  describe('rules 4 and 11: sufficient data', () => {
+    it('needs at least two observations at least 10 minutes apart', () => {
+      expect(project([])).toStrictEqual(unknown('insufficient_data'));
+      expect(project([obs('11:50:00', 50)])).toStrictEqual(unknown('insufficient_data'));
+      expect(project([obs('11:41:00', 40), obs('11:50:00', 50)])).toStrictEqual(unknown('insufficient_data'));
+      expect(project([obs('11:40:00', 40), obs('11:50:00', 50)])).toStrictEqual({
+        ...referenceResult,
+        exhaustedAt: '2026-10-18T12:40:00.000Z',
+        observedFrom: '2026-10-18T11:40:00.000Z',
+      });
+    });
+  });
+
+  describe('rule 5: ordering and immutability', () => {
+    it('gives the same result for unsorted and frozen input without changing it', () => {
+      const frozen = Object.freeze([...reference].reverse().map(item => Object.freeze({ ...item })));
+      const copy = structuredClone(frozen);
+      expect(project(frozen)).toStrictEqual(referenceResult);
+      expect(frozen).toStrictEqual(copy);
+    });
+
+    it('gives the same result for offset inputs and writes UTC', () => {
+      const shifted = [
+        { at: '2026-10-18T13:20:00+02:00', percent: 40, resetsAt: '2026-10-18T17:00:00+02:00' },
+        { at: '2026-10-18T13:50:00.000+02:00', percent: 50, resetsAt: '2026-10-18T17:00:00+02:00' },
+      ];
+      expect(project(shifted)).toStrictEqual(referenceResult);
+    });
+  });
+
+  describe('rule 6: reset of the latest observation', () => {
+    it('refuses a reset at or before the latest observation', () => {
+      expect(project([obs('11:20:00', 40), obs('11:50:00', 50, '2026-10-18T11:50:00Z')]))
+        .toStrictEqual(unknown('reset_mismatch'));
+    });
+
+    it('accepts up to 7 days plus the tolerance', () => {
+      const far = '2026-10-25T11:51:00Z';
+      expect(project([obs('11:20:00', 40, far), obs('11:50:00', 50, far)]).status).toBe('available');
+      const tooFar = '2026-10-26T11:50:00Z';
+      expect(project([obs('11:20:00', 40, tooFar), obs('11:50:00', 50, tooFar)]))
+        .toStrictEqual(unknown('reset_mismatch'));
+    });
+  });
+
+  describe('rule 7: current window segment', () => {
+    it('ignores a previous window dated before the segment', () => {
+      expect(project([obs('10:00:00', 90, '2026-10-18T11:00:00Z'), ...reference])).toStrictEqual(referenceResult);
+    });
+
+    it('refuses interleaved windows and a reset that moves back', () => {
+      expect(project([...reference, obs('11:30:00', 10, '2026-10-18T14:00:00Z')]))
+        .toStrictEqual(unknown('reset_mismatch'));
+      expect(project([obs('11:00:00', 10, '2026-10-18T16:00:00Z'), ...reference]))
+        .toStrictEqual(unknown('reset_mismatch'));
+    });
+
+    it('keeps a 30 s reset drift in the window and splits on 2 min', () => {
+      expect(project([obs('11:20:00', 40), obs('11:50:00', 50, '2026-10-18T15:00:30Z')])).toStrictEqual(referenceResult);
+      expect(project([obs('11:20:00', 40, '2026-10-18T14:58:00Z'), obs('11:50:00', 50)]))
+        .toStrictEqual(unknown('insufficient_data'));
+    });
+  });
+
+  describe('rule 8: freshness', () => {
+    it('is stale once the reset has come', () => {
+      const reset = '2026-10-18T12:00:00Z';
+      expect(project([obs('11:20:00', 40, reset), obs('11:50:00', 50, reset)])).toStrictEqual(unknown('stale'));
+      const past = '2026-10-18T11:55:00Z';
+      expect(project([obs('11:20:00', 40, past), obs('11:50:00', 50, past)])).toStrictEqual(unknown('stale'));
+    });
+
+    it('stays fresh for exactly 30 minutes', () => {
+      expect(project(reference, new Date('2026-10-18T12:20:00Z'))).toStrictEqual(referenceResult);
+      expect(project(reference, new Date('2026-10-18T12:20:00.001Z'))).toStrictEqual(unknown('stale'));
+    });
+
+    it('is stale for an exhausted window observed an hour ago', () => {
+      expect(project([obs('11:00:00', 100)])).toStrictEqual(unknown('stale'));
+    });
+  });
+
+  describe('rules 9 and 12: increase', () => {
+    it('refuses a flat or decreasing segment', () => {
+      expect(project([obs('11:20:00', 50), obs('11:50:00', 50)])).toStrictEqual(unknown('not_increasing'));
+      expect(project([obs('11:20:00', 40), obs('11:30:00', 60), obs('11:50:00', 50)]))
+        .toStrictEqual(unknown('not_increasing'));
+    });
+  });
+
+  describe('rule 10: exhausted window', () => {
+    it('dates exhaustion at the first 100', () => {
+      expect(project([obs('11:20:00', 90), obs('11:30:00', 100), obs('11:50:00', 100)])).toStrictEqual({
+        ...referenceResult,
+        exhaustedAt: '2026-10-18T11:30:00.000Z',
+      });
+    });
+
+    it('accepts a single observation at 100', () => {
+      const instant = '2026-10-18T11:50:00.000Z';
+      expect(project([obs('11:50:00', 100)])).toStrictEqual({
+        ...referenceResult,
+        exhaustedAt: instant,
+        observedFrom: instant,
+        observedTo: instant,
+      });
+    });
+  });
+
+  describe('rules 13 and 14: projection', () => {
+    it('refuses a rise too small to be represented', () => {
+      expect(project([obs('11:40:00', 50), obs('11:50:00', 50 + 1e-12)])).toStrictEqual(unknown('not_increasing'));
+      expect(project([obs('11:20:00', 50), obs('11:50:00', 50 + 1e-7)])).toStrictEqual(unknown('not_increasing'));
+    });
+
+    it('projects a slow rise far beyond the reset', () => {
+      const result = project([obs('11:20:00', 50), obs('11:50:00', 50.001)]);
+      expect(result).toMatchObject({ status: 'available', resetsBeforeExhaustion: true });
+      expect(result.status === 'available' && Date.parse(result.exhaustedAt)).toBeGreaterThan(Date.parse('2029-01-01T00:00:00Z'));
+    });
+
+    it('rounds up to the millisecond', () => {
+      const result = project([obs('11:20:00', 40), obs('11:50:00', 43)]);
+      // 57 points at 3 points per 1 800 000 ms: 34 200 000 ms after 11:50, exactly.
+      expect(result).toMatchObject({ exhaustedAt: '2026-10-18T21:20:00.000Z', resetsBeforeExhaustion: true });
+      const uneven = project([obs('11:20:00', 40), obs('11:50:00', 47)]);
+      // 53 × 1 800 000 / 7 = 13 628 571.43 ms, rounded up to 13 628 572 ms.
+      expect(uneven).toMatchObject({ exhaustedAt: '2026-10-18T15:37:08.572Z', resetsBeforeExhaustion: true });
+    });
+
+    it('does not count a projection on the reset as resetting before', () => {
+      const reset = '2026-10-18T14:20:00Z';
+      expect(project([obs('11:20:00', 40, reset), obs('11:50:00', 50, reset)])).toStrictEqual(referenceResult);
+    });
+  });
+});
