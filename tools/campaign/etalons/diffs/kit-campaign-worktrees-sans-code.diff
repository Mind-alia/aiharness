+            'echo \'{"passed":1,"total":1}\'' % (shlex.quote(str(self.project)), shlex.quote(str(steps))))
+        self.git('add', '.')
+        self.git('commit', '-qm', 'traced scripts')
+        head = self.git('rev-parse', 'HEAD')
