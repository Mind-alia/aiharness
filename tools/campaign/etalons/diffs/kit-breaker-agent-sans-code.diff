--- a/tests/test_campaign.py
+++ b/tests/test_campaign.py
@@ -494,3 +494,72 @@
         self.assertIn('systeme-antigravity', result.stderr)
         self.assertIn('docs/ANTIGRAVITY-SANS-INTERACTION.md', result.stderr)
