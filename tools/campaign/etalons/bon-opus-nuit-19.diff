new file mode 100644
index 0000000..af2471b
--- /dev/null
+++ b/apps/service/src/domain/usage/quota-projection.ts
@@ -0,0 +1,133 @@
+import type { QuotaProjection } from '@wsc/contracts';
+
+export const QUOTA_PROJECTION_MAX_AGE_MS = 30 * 60_000;
+export const QUOTA_PROJECTION_MIN_SPAN_MS = 10 * 60_000;
+export const QUOTA_PROJECTION_RESET_TOLERANCE_MS = 5 * 60_000;
+export const QUOTA_PROJECTION_MIN_INCREASE_PERCENT = 1;
+export const QUOTA_PROJECTION_DROP_TOLERANCE_PERCENT = 1;
+/** Plausible dates: from this instant included… */
+export const QUOTA_PROJECTION_MIN_DATE_MS = Date.UTC(2000, 0, 1);
+/** …to this instant excluded, the bounds of `StatuslineResetSchema`. */
+export const QUOTA_PROJECTION_MAX_DATE_MS = Date.UTC(2100, 0, 1);
+
+/** One status-line reading of a single quota window. */
+export interface QuotaObservation {
+  readonly at: string;
+  readonly percent: number;
+  readonly resetsAt: string;
+}
+
+type QuotaProjectionReason = Extract<QuotaProjection, { status: 'unknown' }>['reason'];
+
+interface Point {
+  readonly atMs: number;
+  readonly percent: number;
+  readonly resetMs: number;
+}
+
+// Same shape as `z.iso.datetime({ offset: true })`: seconds required, `Z` or `±hh:mm`.
+const ISO_DATETIME = /^(\d{4})-(\d{2})-(\d{2})T(?:[01]\d|2[0-3]):[0-5]\d:[0-5]\d(?:\.\d+)?(?:Z|[+-](?:[01]\d|2[0-3]):[0-5]\d)$/;
+
+function unknown(reason: QuotaProjectionReason): QuotaProjection {
+  return { status: 'unknown', reason, fiabilite: 'inconnu' };
+}
+
+function iso(ms: number): string {
+  return new Date(ms).toISOString();
+}
+
+function parseInstant(value: string): number | null {
+  const match = ISO_DATETIME.exec(value);
+  if (!match) return null;
+  const [year, month, day] = [Number(match[1]), Number(match[2]), Number(match[3])];
+  const daysInMonth = new Date(Date.UTC(year, month, 0)).getUTCDate();
+  if (month < 1 || month > 12 || day < 1 || day > daysInMonth) return null;
+  const ms = Date.parse(value);
+  if (Number.isNaN(ms) || ms < QUOTA_PROJECTION_MIN_DATE_MS || ms >= QUOTA_PROJECTION_MAX_DATE_MS) return null;
+  return ms;
+}
+
+function toPoint(observation: QuotaObservation, nowMs: number): Point | null {
+  const atMs = parseInstant(observation.at);
+  const resetMs = parseInstant(observation.resetsAt);
+  const { percent } = observation;
+  if (atMs === null || resetMs === null) return null;
+  if (!Number.isFinite(percent) || percent < 0 || percent > 100) return null;
+  if (atMs > nowMs || resetMs <= atMs) return null;
+  return { atMs, percent, resetMs };
+}
+
+/** Sorted copy without identical duplicates; null when one instant carries two different readings. */
+function sortUnique(points: readonly Point[]): readonly Point[] | null {
+  const sorted = [...points].sort((a, b) => a.atMs - b.atMs);
+  const unique: Point[] = [];
+  for (const point of sorted) {
+    const previous = unique.at(-1);
+    if (previous?.atMs !== point.atMs) unique.push(point);
+    else if (previous.percent !== point.percent || previous.resetMs !== point.resetMs) return null;
+  }
+  return unique;
+}
+
+/** Trailing run announcing the reset `resetMs`; null when another cycle overlaps it or announces a later reset. */
+function currentCycle(points: readonly Point[], resetMs: number): readonly Point[] | null {
+  const inCycle = (point: Point) => Math.abs(point.resetMs - resetMs) <= QUOTA_PROJECTION_RESET_TOLERANCE_MS;
+  const start = points.findIndex(inCycle);
+  const cycle = points.slice(start);
+  const earlier = points.slice(0, start);
+  if (!cycle.every(inCycle)) return null;
+  if (!earlier.every(point => point.resetMs < resetMs - QUOTA_PROJECTION_RESET_TOLERANCE_MS)) return null;
+  return cycle;
+}
+
+function dropsTooMuch(cycle: readonly Point[]): boolean {
+  let max = -Infinity;
+  for (const point of cycle) {
+    if (point.percent < max - QUOTA_PROJECTION_DROP_TOLERANCE_PERCENT) return true;
+    max = Math.max(max, point.percent);
+  }
+  return false;
+}
+
+function projectCycle(cycle: readonly Point[], resetMs: number): QuotaProjection {
+  const first = cycle[0];
+  const last = cycle[cycle.length - 1];
+  const full = cycle.find(point => point.percent === 100);
+  if (full) {
+    const at = iso(full.atMs);
+    return { status: 'available', exhaustedAt: at, observedFrom: iso(first.atMs), observedTo: at, fiabilite: 'estime', resetsBeforeExhaustion: false };
+  }
+  const span = last.atMs - first.atMs;
+  if (cycle.length < 2 || span < QUOTA_PROJECTION_MIN_SPAN_MS) return unknown('insufficient_data');
+  const increase = last.percent - first.percent;
+  if (increase < QUOTA_PROJECTION_MIN_INCREASE_PERCENT) return unknown('not_increasing');
+  const exhaustedMs = Math.round(last.atMs + (100 - last.percent) / (increase / span));
+  if (exhaustedMs >= QUOTA_PROJECTION_MAX_DATE_MS) return unknown('not_increasing');
+  return {
+    status: 'available',
+    exhaustedAt: iso(exhaustedMs),
+    observedFrom: iso(first.atMs),
+    observedTo: iso(last.atMs),
+    fiabilite: 'estime',
+    resetsBeforeExhaustion: resetMs <= exhaustedMs,
+  };
+}
+
+/** Pure projection of when one quota window reaches 100 %, from its status-line observations. */
+export function projectQuota(observations: readonly QuotaObservation[], now: Date): QuotaProjection {
+  const nowMs = now.getTime();
+  if (Number.isNaN(nowMs)) return unknown('invalid');
+  const points = observations
+    .map(observation => toPoint(observation, nowMs))
+    .filter((point): point is Point => point !== null);
+  if (points.length !== observations.length) return unknown('invalid');
+  const sorted = sortUnique(points);
+  if (!sorted) return unknown('invalid');
+  const last = sorted.at(-1);
+  if (!last) return unknown('insufficient_data');
+  if (nowMs - last.atMs > QUOTA_PROJECTION_MAX_AGE_MS || last.resetMs <= nowMs) return unknown('stale');
+  const cycle = currentCycle(sorted, last.resetMs);
+  if (!cycle) return unknown('reset_mismatch');
+  if (dropsTooMuch(cycle)) return unknown('invalid');
+  return projectCycle(cycle, last.resetMs);
+}
