+class NormalizeTests(unittest.TestCase):
+    def test_old_header_and_mode_are_rewritten(self):
+        self.assertEqual(etalons_harvest.normalize(OLD_DIFF),
+                         OLD_DIFF.replace(b'diff --git/notes', b'diff --git a/notes')
+                         .replace(b'100600', b'100644'))
+
+    def test_deleted_file_mode_is_rewritten(self):
+        data = b'diff --git/gone.txt b/gone.txt\ndeleted file mode 100600\n'
+        self.assertEqual(etalons_harvest.normalize(data),
+                         b'diff --git a/gone.txt b/gone.txt\ndeleted file mode 100644\n')
+
+    def test_equal_mode_pair_is_removed(self):
+        data = b'diff --git a/x b/x\nold mode 100644\nnew mode 100600\n@@ -1 +1 @@\n-a\n+b\n'
+        self.assertEqual(etalons_harvest.normalize(data), b'diff --git a/x b/x\n@@ -1 +1 @@\n-a\n+b\n')
+
+    def test_executable_pair_is_kept_and_normalized(self):
+        data = b'diff --git a/run.sh b/run.sh\nold mode 100600\nnew mode 100755\n'
+        self.assertEqual(etalons_harvest.normalize(data),
+                         b'diff --git a/run.sh b/run.sh\nold mode 100644\nnew mode 100755\n')
+
+    def test_other_bytes_are_kept(self):
+        data = b'diff --git a/b.bin b/b.bin\n@@ -1 +1 @@\n-x\xff\r\n+y\xfe'
+        self.assertEqual(etalons_harvest.normalize(data), data)
+
+    def test_normalized_old_diff_is_accepted_by_git(self):
+        if shutil.which('git') is None:
+            self.skipTest('git absent')
+        with tempfile.TemporaryDirectory() as tmp:
+            done = subprocess.run(['git', 'apply', '--check', '-'], cwd=tmp, input=etalons_harvest.normalize(OLD_DIFF),
+                                  stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+            self.assertEqual(done.returncode, 0, done.stdout)
+
